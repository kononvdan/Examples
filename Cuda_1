float find_mm(float *A, bool max)
{
    float result = A[0];
    if (max)
    {
        for (int i = 1; i < S * S; i++)
        {
            if (A[i] > result)
                result = A[i];
        }
    }
    else
    {
        for (int i = 1; i < S * S; i++)
        {
            if (A[i] < result)
                result = A[i];
        }
    }
    return result;
}

int main(int argc, char **argv)
{

    float *A;
    A = new float[S * S];
    float *for_gpu_A;
    float *for_gpu_B;

    // bool *check;
    // check = new bool[_s_var];
    // bool *for_gpu_check;

    cudaMalloc((void **)&for_gpu_A, S * S * sizeof(float));
    cudaMalloc((void **)&for_gpu_B, S * S * sizeof(float));
    // cudaMalloc((void **)&for_gpu_check, _s_var * sizeof(bool));

    InfillArray<<<dim3(BLOCKS), dim3(THREADS)>>>(for_gpu_A);
    cudaDeviceSynchronize();
    cudaMemcpy((void *)A, (void *)for_gpu_A, S * S * sizeof(float), cudaMemcpyDeviceToHost);
    
    print_array(A);


    std::cout << "infilled" << std::endl;

    bool even = true;
    int i = 0;
    do
    {
        even = !even;
        
        if(even){
            cudaMemcpy((void *)A, (void *)for_gpu_A, S * S * sizeof(float), cudaMemcpyDeviceToHost);
        } else {
            cudaMemcpy((void *)A, (void *)for_gpu_B, S * S * sizeof(float), cudaMemcpyDeviceToHost);
        }
        if (find_mm(A, true) - find_mm(A, false) < e && i != 0)
        {
            break;
        }
        i+=1;

        if (even) {
            UpdateArray<<<dim3(BLOCKS), dim3(THREADS)>>>(for_gpu_B, for_gpu_A);
        } else {
            UpdateArray<<<dim3(BLOCKS), dim3(THREADS)>>>(for_gpu_A, for_gpu_B);
        }
        cudaDeviceSynchronize();
        
    

    } while (true);

    if (even) {
        cudaMemcpy((void *)A, (void *)for_gpu_A, S * S * sizeof(float), cudaMemcpyDeviceToHost);
    } else {
        cudaMemcpy((void *)A, (void *)for_gpu_B, S * S * sizeof(float), cudaMemcpyDeviceToHost);
    }
    print_array(A);

    cudaFree(for_gpu_A);
    cudaFree(for_gpu_B);

    return 0;
}
